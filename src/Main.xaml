  <Grid x:Name="Welcome" Visibility="Collapsed" Background="#ED050607" KeyboardNavigation.TabNavigation="Cycle"><Border Style="{StaticResource Panel}" Width="740" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Background="#0C0F10" CornerRadius="17,0,0,17" Padding="26"><DockPanel><TextBlock DockPanel.Dock="Top" Text="BlockMook" Foreground="#EFF3F2" FontSize="21" FontWeight="Bold"/><TextBlock DockPanel.Dock="Bottom" Text="Меньше преград.&#x0a;Больше своего." Foreground="#A6A9AF" FontSize="15" LineHeight="23"/><Viewbox Width="112" Height="138" VerticalAlignment="Center"><Path Data="{StaticResource BrandMark}" Fill="#00E8D2"/></Viewbox></DockPanel></Border>
