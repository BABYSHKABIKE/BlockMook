    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0"><TextBlock Text="Настройки" Style="{StaticResource Heading}"/><TextBlock Text="Подключение и интерфейс — под твоим контролем." Foreground="#95989E" Margin="0,0,0,26"/>
