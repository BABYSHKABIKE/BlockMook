     <Border Style="{StaticResource Panel}" Padding="28"><StackPanel><DockPanel><Border Background="#1C00E8D2" CornerRadius="10" Width="48" Height="48" Margin="0,0,16,0" DockPanel.Dock="Left"><Path Data="M 3,8 A 13,13 0 1 1 3,20 M 3,0 L 3,8 L 11,8" Stroke="#00E8D2" StrokeThickness="2" Width="29" Height="30"/></Border><StackPanel><TextBlock x:Name="UpdateTitle" Text="BlockMook 1.0" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="UpdateStatus" Text="Проверь, появилась ли новая версия." Foreground="#95989E" Margin="0,5,0,0"/></StackPanel></DockPanel>
      <WrapPanel Margin="0,24,0,0"><Button x:Name="CheckUpdates" Content="Проверить обновления" Style="{StaticResource Primary}" Margin="0,0,10,8"/><Button x:Name="DownloadUpdate" Content="Скачать ZIP" Margin="0,0,10,8" Visibility="Collapsed"/><Button x:Name="CancelUpdate" Content="Отменить" Margin="0,0,10,8" Visibility="Collapsed"/><Button x:Name="OpenUpdate" Content="Открыть загрузку" Margin="0,0,0,8" Visibility="Collapsed"/></WrapPanel>
      <ProgressBar x:Name="UpdateProgress" Height="4" Margin="0,10,0,0" Minimum="0" Maximum="100" Visibility="Collapsed" Foreground="#00E8D2" Background="#292D30" BorderThickness="0"/>
     </StackPanel></Border>
     <TextBlock Text="Что нового" Style="{StaticResource Section}" Margin="0,27,0,14"/><Border Style="{StaticResource Panel}"><TextBlock x:Name="ReleaseNotes" Text="BlockMook 1.0&#x0a;&#x0a;• Чёрный интерфейс и бирюзовые акценты.&#x0a;• Каталог сервисов и автоматический подбор подключения.&#x0a;• Работа в трее и автовосстановление.&#x0a;• Диагностика, скорость сети и пинг внутри приложения.&#x0a;• Обновления с проверкой целостности." Foreground="#B9BCC2" LineHeight="24"/></Border>
     <DockPanel Margin="2,18,0,0"><Button x:Name="ReleasePage" Content="Релизы на GitHub ↗" DockPanel.Dock="Right" Background="Transparent" Foreground="#00E8D2" Padding="0,5"/><TextBlock Text="По запросу · без фоновых загрузок" Style="{StaticResource Caption}" VerticalAlignment="Center"/></DockPanel><TextBlock Text="Выйди из BlockMook через трей, распакуй архив и открой Install.cmd. Для переносимого запуска — Start.cmd. Настройки сохранятся." Style="{StaticResource Caption}" Margin="2,10,0,0"/>
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="DiagnosticsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0"><TextBlock Text="Диагностика" Style="{StaticResource Heading}"/><TextBlock Text="Понятный результат. Конкретный следующий шаг." Foreground="#95989E" Margin="0,0,0,26"/>
     <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Проверка соединений" Style="{StaticResource Section}"/><TextBlock Text="Проверим выбранные сервисы, не переключая подключение. Аккаунты, сообщения и история браузера не нужны." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,20"/>
      <WrapPanel><Button x:Name="QuickDiagnostic" Content="Проверить подключение" Style="{StaticResource Primary}" Margin="0,0,10,10"/><Button x:Name="CancelQuick" Content="Отменить проверку" Visibility="Collapsed" Margin="0,0,10,10"/><Button x:Name="ExportDiagnostic" Content="Сохранить отчёт" IsEnabled="False" Margin="0,0,0,10"/></WrapPanel>
      <TextBlock x:Name="DiagnosticAdvice" Text="Ещё не проверяли." Foreground="#A6A9AF" Margin="0,10,0,15"/>
      <TextBox x:Name="DiagnosticPreview" Text="Здесь появится результат. В файл сохранится только показанный текст: без локальных путей, IP-адресов и журнала." Height="210" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#090B0C" Foreground="#C9D2D2" BorderBrush="#292D30" Padding="14"/>
     </StackPanel></Border>
     <TextBlock Text="Восстановление" Style="{StaticResource Section}" Margin="0,24,0,10"/><TextBlock x:Name="RecoveryStatus" Text="Начнёт наблюдать после подключения. Ручное отключение отменяет восстановление." Foreground="#95989E"/>
     <Expander Header="Проверить все профили · изменяет подключение" Foreground="#A6A9AF" Margin="0,18,0,0">     <Border Style="{StaticResource Panel}" Margin="0,18,0,0"><StackPanel><TextBlock Text="Расширенная проверка" Style="{StaticResource Section}"/><TextBlock Text="Отключи другой VPN или другой сетевой инструмент и повтори подключение. Диагностика проверит все три профиля и сохранит отчёт." Foreground="#95989E" Margin="0,12,0,18"/><WrapPanel><Button x:Name="Diagnostic" Content="Диагностика" Margin="0,0,8,8"/><Button x:Name="CancelDiagnostic" Content="Остановить" Margin="0,0,8,8" Visibility="Collapsed"/><Button x:Name="OpenReports" Content="Отчёты" Margin="0,0,0,8"/></WrapPanel><TextBlock x:Name="DiagnosticStatus" Text="До 3 минут. Текущее подключение и автовосстановление будут отключены. Итоговый технический отчёт может содержать локальные пути." Style="{StaticResource Caption}"/></StackPanel></Border>
</Expander></StackPanel></ScrollViewer>
    <ScrollViewer x:Name="HelpPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0"><TextBlock Text="О приложении" Style="{StaticResource Heading}"/><TextBlock Text="Открытый код. Прозрачное устройство." Foreground="#95989E" Margin="0,0,0,26"/>
     <Border Style="{StaticResource Panel}"><StackPanel><DockPanel><TextBlock Text="Сделано на открытом коде" Style="{StaticResource Section}"/><Button x:Name="SourcePage" Content="GitHub ↗" HorizontalAlignment="Right" Background="Transparent" Foreground="#00E8D2" Padding="8,3"/></DockPanel><TextBlock Text="BlockMook добавляет интерфейс, автоматический подбор профиля, диагностику и обновления. В основе подключения — zapret от bol-van и сборка Flowseal. Сетевые компоненты сохранены без изменений." Foreground="#A6A9AF" Margin="0,15,0,0" LineHeight="22"/><Border Height="1" Background="#292D30" Margin="0,20"/><WrapPanel><Button x:Name="CreditZapret" Content="bol-van / zapret ↗" Padding="12,8" Margin="0,0,8,8"/><Button x:Name="CreditFlowseal" Content="Flowseal ↗" Padding="12,8" Margin="0,0,8,8"/><Button x:Name="CreditWinDivert" Content="WinDivert ↗" Padding="12,8" Margin="0,0,8,8"/><Button x:Name="CreditCygwin" Content="Cygwin ↗" Padding="12,8" Margin="0,0,8,8"/></WrapPanel><TextBlock Text="Лицензии и исходники компонентов включены в архив релиза." Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel></Border>
     <Expander Header="Данные и ограничения" Foreground="#A6A9AF" Margin="0,20,0,0"><TextBlock Text="Без аккаунта и телеметрии. Проверки обращаются к выбранным сервисам и Microsoft; для Meet также выполняется UDP/STUN-запрос к Google; обновления — к GitHub. Это не VPN: IP-адрес не скрывается. Успешная проверка не гарантирует вход в аккаунт, видео или голосовой звонок.&#x0a;&#x0a;Настройки: LocalAppData\BlockMook. Отчёты: reports рядом с программой. Отчёты могут содержать локальные пути — просмотри их перед отправкой. DNS и прокси не меняются. Автозапуск включается отдельно в настройках. При включённом восстановлении выбранные сервисы проверяются в фоне." Foreground="#95989E" Margin="0,12,0,6"/></Expander>
     <Expander Header="Журнал сеанса" Foreground="#A6A9AF" Margin="0,8,0,0"><TextBox x:Name="Log" Height="180" Margin="0,12,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#0C0E10" Foreground="#A6A9AF" BorderThickness="0" Padding="12" FontFamily="Consolas" FontSize="12"/></Expander>
    </StackPanel></ScrollViewer>
   </Grid>
  </Grid>
  <Grid x:Name="Catalog" Visibility="Collapsed" Background="#ED050607" KeyboardNavigation.TabNavigation="Cycle"><Border Style="{StaticResource Panel}" Width="650" MaxHeight="640" Margin="20" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center"><DockPanel>
   <StackPanel DockPanel.Dock="Top"><DockPanel><Button x:Name="CatalogClose" Content="Закрыть" DockPanel.Dock="Right" Padding="12,8" Background="Transparent"/><TextBlock Text="Добавить сервис" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock Text="Выбери нужное. Остальное не участвует в проверках." Foreground="#95989E" Margin="0,8,0,18"/>
    <TextBlock Text="Поиск по названию" Style="{StaticResource Caption}" Margin="0,0,0,6"/><TextBox x:Name="CatalogSearch" AutomationProperties.Name="Поиск сервиса" Background="#08090A" Foreground="#F2F2ED" CaretBrush="#00E8D2" BorderBrush="#45484F" BorderThickness="1" Padding="12,10" FontSize="15" Margin="0,0,0,16"/>
