  </Grid></Border></Grid>
  <Grid x:Name="TrayNotice" Visibility="Collapsed" Background="#ED050607" KeyboardNavigation.TabNavigation="Cycle"><Border Style="{StaticResource Panel}" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="Закрыть BlockMook?" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Убрать в трей — подключение продолжит работать.&#x0a;&#x0a;Закрыть полностью — остановить BlockMook, его сетевой компонент и фоновые проверки." Foreground="#A6A9AF" Margin="0,16,0,24"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="TrayNoticeHide" Content="Убрать в трей" Style="{StaticResource Primary}" Padding="12,13"/><Button x:Name="TrayNoticeExit" Grid.Column="2" Content="Закрыть полностью" Padding="12,13"/></Grid><Button x:Name="TrayNoticeCancel" Content="Отмена" Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" Margin="0,12,0,0"/></StackPanel></Border></Grid>
